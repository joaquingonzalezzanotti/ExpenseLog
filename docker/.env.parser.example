# ┌─────────────────────────────────────────────────────────┐
# │  AI Parser (Gemini) – Environment Configuration         │
# │  Copy to .env.parser and fill in the values.            │
# └─────────────────────────────────────────────────────────┘

GEMINI_API_KEY=                     # from aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
INTERNAL_TOKEN=                     # share with .env AI_PARSER_INTERNAL_TOKEN
PORT=3000
LOG_LEVEL=info
MAX_MEDIA_BYTES=8388608
JSON_BODY_LIMIT=20mb
