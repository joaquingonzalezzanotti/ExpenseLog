{
  "redirects": [
    {
      "source": "/",
      "destination": "/landing.html",
      "permanent": false
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/table",
      "destination": "/app/table",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/app/settings",
      "permanent": true
    },
    {
      "source": "/perfil",
      "destination": "/app/perfil",
      "permanent": true
    },
    {
      "source": "/categorias",
      "destination": "/app/categorias",
      "permanent": true
    },
    {
      "source": "/recurrentes",
      "destination": "/app/recurrentes",
      "permanent": true
    },
    {
      "source": "/conciliacion",
      "destination": "/app/conciliacion",
      "permanent": true
    },
    {
      "source": "/reportes",
      "destination": "/app/reportes",
      "permanent": true
    },
    {
      "source": "/apple-wallet",
      "destination": "/app/apple-wallet",
      "permanent": true
    },
    {
      "source": "/app/index",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/app/index.html",
      "destination": "/app",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "https://expenselog-production.up.railway.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://expenselog-production.up.railway.app/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://expenselog-production.up.railway.app/api/:path*"
    }
  ]
}
