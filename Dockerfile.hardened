# ── Build stage ──────────────────────────────────────────────
FROM public.ecr.aws/docker/library/golang:1.25.9-alpine3.22 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/expenselog ./cmd/expenselog

# ── Runtime stage ────────────────────────────────────────────
FROM public.ecr.aws/docker/library/alpine:3.22

LABEL org.opencontainers.image.source="https://github.com/joaquingonzalezzanotti/ExpenseLog"
LABEL org.opencontainers.image.description="ExpenseLog – hardened self-hosted image"

RUN apk add --no-cache \
      ca-certificates \
      tesseract-ocr \
      tesseract-ocr-data-spa \
      poppler-utils \
      wget \
    && addgroup -g 10001 -S appgroup \
    && adduser  -u 10001 -S appuser -G appgroup \
    && mkdir -p /app/data /tmp/ocr \
    && chown -R appuser:appgroup /app /tmp/ocr

WORKDIR /app
COPY --from=builder --chown=appuser:appgroup /app/expenselog /app/expenselog

USER appuser
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/ready || exit 1

CMD ["./expenselog"]
