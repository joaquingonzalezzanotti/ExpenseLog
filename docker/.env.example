# ┌─────────────────────────────────────────────────────────┐
# │  ExpenseLog – Self-hosted Environment Configuration     │
# │  Copy to .env and fill in the values.                   │
# └─────────────────────────────────────────────────────────┘

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=expenselog
POSTGRES_PASSWORD=              # generate with: openssl rand -base64 24

# ── ExpenseLog App ────────────────────────────────────────
STORAGE_TYPE=postgres
STORAGE_URL=postgres:5432/expenselog
STORAGE_USER=expenselog
STORAGE_PASS=                   # same as POSTGRES_PASSWORD
STORAGE_SSL=disable             # internal traffic, no SSL needed

# Bootstrap admin user (only used on first boot)
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# App identity
APP_NAME=ExpenseLog
APP_BASE_URL=https://me.expenselog.com.ar
APP_LOGO_URL=
SUPPORT_EMAIL=soporte@expenselog.com.ar

# Google OAuth – disabled for personal instance
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://me.expenselog.com.ar/api/auth/google/callback

# Email (Brevo or SMTP) – configure if you need password reset emails
BREVO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=ExpenseLog

# Bot integration (shared secret with .env.bot)
EXPENSELOG_BOT_INTERNAL_SECRET=    # generate with: openssl rand -hex 32
TELEGRAM_BOT_USERNAME=

# WhatsApp / Kapso (optional)
# WHATSAPP_KAPSO_NUMBER=
# WHATSAPP_KAPSO_DEFAULT_MESSAGE=
# KAPSO_WEBHOOK_SECRET=
# KAPSO_API_KEY=
# KAPSO_MEDIA_ALLOWED_HOSTS=

# OCR (used by WhatsApp media processing)
WHATSAPP_OCR_FALLBACK_ENABLED=true
WHATSAPP_OCR_LANGS=spa+eng
OCR_LANGS=spa+eng

# AI Parser (points to internal ai-parser service)
AI_PARSER_BASE_URL=http://ai-parser:3000
AI_PARSER_PARSE_PATH=/api/parse
AI_PARSER_INTERNAL_TOKEN=           # share with .env.parser INTERNAL_TOKEN
WHATSAPP_AI_FALLBACK_ENABLED=true

# ── Cloudflare Tunnel ─────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=            # from dashboard.cloudflare.com → Zero Trust → Tunnels
