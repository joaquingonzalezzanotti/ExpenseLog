generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TelegramUserLink {
  id                          String   @id @default(uuid())
  telegramUserId              BigInt   @unique @map("telegram_user_id")
  expenselogUserId            String   @map("expenselog_user_id")
  expenselogApiTokenEncrypted String   @map("expenselog_api_token_encrypted")
  createdAt                   DateTime @default(now()) @map("created_at")

  @@map("telegram_user_link")
}

model ReceiptDraft {
  id                      String   @id @default(uuid())
  telegramUserId          BigInt   @map("telegram_user_id")
  chatId                  BigInt   @map("chat_id")
  messageId               Int      @map("message_id")
  fileId                  String   @map("file_id")
  fileUniqueId            String   @map("file_unique_id")
  fileType                String   @map("file_type")
  status                  String
  parseResultJson         Json     @map("parse_result_json")
  dedupeKey               String   @map("dedupe_key")
  reference               String?
  expenselogTransactionId String?  @map("expenselog_transaction_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([telegramUserId, createdAt])
  @@index([reference, status])
  @@index([dedupeKey, status])
  @@map("receipt_draft")
}

model UserRule {
  id             String   @id @default(uuid())
  telegramUserId BigInt   @map("telegram_user_id")
  enabled        Boolean  @default(true)
  priority       Int      @default(100)
  whenJson       Json     @map("when_json")
  thenJson       Json     @map("then_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([telegramUserId, enabled, priority])
  @@map("user_rule")
}
