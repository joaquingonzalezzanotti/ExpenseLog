# Required
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://user:pass@localhost:5432/expenselog_bot?schema=public
EXPENSELOG_API_BASE_URL=
EXPENSELOG_WEB_BASE_URL=
EXPENSELOG_BOT_INTERNAL_SECRET=

# Auth for ExpenseLog API (use one)
EXPENSELOG_API_TOKEN=
EXPENSELOG_SESSION_COOKIE=

# Optional bot access controls
ALLOWED_TELEGRAM_USER_IDS=
TELEGRAM_ADMIN_USER_ID=
MY_ALIASES=

# Optional API behavior
EXPENSELOG_ADAPTER_MODE=expense_api
EXPENSELOG_TRANSACTIONS_PATH=/api/transactions
EXPENSELOG_EXPENSE_PATH=/api/expense
EXPENSELOG_BOT_CONSUME_LINK_CODE_PATH=/api/bot/telegram/consume-link-code
EXPENSELOG_BOT_LINK_STATUS_PATH=/api/bot/telegram/link-status
EXPENSELOG_BOT_EXPENSE_PATH=/api/bot/expense
EXPENSELOG_DEFAULT_EXPENSE_CATEGORY=Varios
EXPENSELOG_DEFAULT_INCOME_CATEGORY=Ingresos
EXPENSELOG_DEFAULT_SOURCE=CA

# Runtime / parsing
TZ_DEFAULT=America/Argentina/Buenos_Aires
OCR_LANGS=spa+eng
PDF_RENDER_MAX_PAGES=1
AI_PARSER_FALLBACK_ENABLED=true
AI_PARSER_BASE_URL=
AI_PARSER_PARSE_PATH=/api/parse
AI_PARSER_API_KEY=
AI_PARSER_API_KEY_HEADER=X-API-Key
AI_PARSER_TIMEOUT_MS=8000
AI_PARSER_MIN_CONFIDENCE=0.55
AI_PARSER_TEXT_ENABLED=false
LOG_LEVEL=info
PORT=3000
