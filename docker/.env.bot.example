# ┌─────────────────────────────────────────────────────────┐
# │  Telegram Receipt Bot – Environment Configuration       │
# │  Copy to .env.bot and fill in the values.               │
# └─────────────────────────────────────────────────────────┘

# Telegram bot token (create a new bot via @BotFather for the homeserver)
TELEGRAM_BOT_TOKEN=

# PostgreSQL (bot's own database, same server)
DATABASE_URL=postgresql://expenselog:PASSWORD_HERE@postgres:5432/expenselog_bot?schema=public

# ExpenseLog API (internal Docker network)
EXPENSELOG_API_BASE_URL=http://expenselog:8080
EXPENSELOG_WEB_BASE_URL=https://me.expenselog.com.ar
EXPENSELOG_BOT_INTERNAL_SECRET=    # same as in .env

# Adapter mode
EXPENSELOG_ADAPTER_MODE=expense_api
EXPENSELOG_TRANSACTIONS_PATH=/api/transactions
EXPENSELOG_EXPENSE_PATH=/api/expense
EXPENSELOG_BOT_CONSUME_LINK_CODE_PATH=/api/bot/telegram/consume-link-code
EXPENSELOG_BOT_LINK_STATUS_PATH=/api/bot/telegram/link-status
EXPENSELOG_BOT_EXPENSE_PATH=/api/bot/expense
EXPENSELOG_DEFAULT_EXPENSE_CATEGORY=Varios
EXPENSELOG_DEFAULT_INCOME_CATEGORY=Ingresos
EXPENSELOG_DEFAULT_SOURCE=CA

# AI Parser (internal Docker network)
AI_PARSER_FALLBACK_ENABLED=true
AI_PARSER_BASE_URL=http://ai-parser:3000
AI_PARSER_PARSE_PATH=/api/parse
AI_PARSER_API_KEY=                  # same as INTERNAL_TOKEN in .env.parser
AI_PARSER_API_KEY_HEADER=X-Internal-Token
AI_PARSER_TIMEOUT_MS=8000
AI_PARSER_MIN_CONFIDENCE=0.55
AI_PARSER_TEXT_ENABLED=false

# Runtime
TZ_DEFAULT=America/Argentina/Buenos_Aires
OCR_LANGS=spa+eng
PDF_RENDER_MAX_PAGES=1
LOG_LEVEL=info
PORT=3000

# Access controls (optional)
# ALLOWED_TELEGRAM_USER_IDS=
# TELEGRAM_ADMIN_USER_ID=
# MY_ALIASES=
